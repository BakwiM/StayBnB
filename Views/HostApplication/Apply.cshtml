@model HostApplicationVm
<h1>Become a Host</h1><p>Provide your property details. At least one image is required.</p>
<form asp-action="Apply" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="error"></div>
<label asp-for="Title"></label><input asp-for="Title"/><span asp-validation-for="Title" class="error"></span>
<label asp-for="Description"></label><textarea asp-for="Description"></textarea>
<label asp-for="City"></label><input asp-for="City"/><label asp-for="Address"></label><input asp-for="Address"/>
<label asp-for="PropertyType"></label><select asp-for="PropertyType"><option>Apartment</option><option>House</option><option>Guesthouse</option></select>
<label asp-for="PricePerNight"></label><input asp-for="PricePerNight" type="number" step="0.01"/>
<label asp-for="CleaningFee"></label><input asp-for="CleaningFee" type="number" step="0.01"/>
<label asp-for="ServiceFee"></label><input asp-for="ServiceFee" type="number" step="0.01"/>
<label asp-for="Image">Property image</label><input asp-for="Image" type="file" accept="image/*"/><span asp-validation-for="Image" class="error"></span>
<button type="submit">Submit application</button></form>

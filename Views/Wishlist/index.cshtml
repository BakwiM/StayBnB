@model IEnumerable<WishlistItem>
<h1>My Wishlist</h1> <div class="grid"> @foreach(var w in Model) { <article class="card"> @if(w.Property!.Images.Any()){<img class="thumb" src="@w.Property.Images.First().ImagePath"/>} <h2>@w.Property?.Title</h2> <p>@w.Property?.City · @w.Property?.PropertyType</p> <strong>R @w.Property?.PricePerNight.ToString("N2") / night</strong><br/><br/> <form method="post" asp-controller="Wishlist" asp-action="Toggle" asp-route-propertyId="@w.PropertyId" style="display:inline"><button type="submit">Remove</button></form> <a class="btn" asp-controller="Booking" asp-action="Create" asp-route-id="@w.PropertyId">Book</a> </article> } </div> 
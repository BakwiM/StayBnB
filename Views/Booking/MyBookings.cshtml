@model IEnumerable<Booking>
<h1>My Bookings</h1> <table class="table"> <tr><th>Property</th><th>Dates</th><th>Travelers</th><th>Total</th><th>Status</th><th>Actions</th></tr> @foreach (var b in Model) { <tr> <td>@b.Property?.Title</td> <td>@b.CheckIn.ToShortDateString() - @b.CheckOut.ToShortDateString()</td> <td>@b.Travelers</td> <td>R @b.TotalPrice.ToString("N2")</td> <td>@b.Status</td> <td> @if (b.Status == BookingStatus.Approved) { <a class="btn" asp-action="CheckIn" asp-route-id="@b.Id">Upload ID/Passport</a> } @if (b.Status == BookingStatus.CheckedIn && !((HashSet<int>)ViewBag.ReviewedPropertyIds).Contains(b.PropertyId)) { <a class="btn" asp-action="AddReview" asp-route-bookingId="@b.Id">Leave a Review</a> } </td> </tr> } </table>
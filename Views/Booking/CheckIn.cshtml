@model Booking
<h1>Guest Check-in</h1><p>Booking for <b>@Model.Property?.Title</b> is approved. Upload your ID or Passport for host verification.</p>
<form asp-action="CheckIn" method="post" enctype="multipart/form-data"><input type="hidden" name="id" value="@Model.Id"/><input type="file" name="document" accept=".pdf,image/*" required/><button>Upload Document</button></form>
